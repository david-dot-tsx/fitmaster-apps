{
  "name": "@repo/db",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "db:push": "prisma db push",
    "db:generate": "DATABASE_URL=postgresql://noop:noop@localhost:5432/noop prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "postinstall": "pnpm db:generate || echo 'Prisma generate failed, skipping...'",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.2.0",
    "@prisma/client": "7.2.0",
    "@t3-oss/env-core": "0.13.10",
    "dotenv": "17.2.3",
    "pg": "8.17.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.3.0",
    "@inquirer/prompts": "^8.3.0",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "22.15.3",
    "@types/pg": "8.16.0",
    "eslint": "9.39.1",
    "prisma": "7.2.0",
    "tsx": "4.19.2"
  },
  "exports": {
    "./prisma": {
      "import": "./src/prisma.ts",
      "types": "./src/prisma.ts"
    },
    "./types": {
      "import": "./src/types.ts",
      "types": "./src/types.ts"
    }
  }
}

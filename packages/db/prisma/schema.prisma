generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TRAINER
  CUSTOMER
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum BodyPart {
  CHEST
  SHOULDERS
  BACK
  ARMS
  LEGS
}

enum WorkoutType {
  STRENGTH
  HYPERTROPHY
  ENDURANCE
  POWER
  MOBILITY
  FLEXIBILITY
  BALANCE
  RECOVERY
}

enum WorkoutBlockType {
  WARM_UP
  MAIN_WORKOUT
  REST
  COOL_DOWN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}
/*********
 * User
 *********
 */
model User {
  id        String    @id @default(uuid())
  email     String    @unique
  createdAt DateTime  @default(now())
  deletedAt DateTime?
  role      Role      @default(CUSTOMER)
  updatedAt DateTime  @updatedAt
  passwordHash  String?
  profile   Profile?
  sessions  Session[]
}

model Profile {
  id              String           @id @default(uuid())
  userId          String           @unique
  bio             String?
  nickname        String
  firstName       String?
  lastName        String?
  birthDate       DateTime
  gender          Gender
  imageUrl        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  deletedAt       DateTime?
  customerProfile CustomerProfile?
  user            User             @relation(fields: [userId], references: [id])
  trainerProfile  TrainerProfile?
}

model TrainerProfile {
  id        String    @id @default(uuid())
  profileId String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  profile   Profile   @relation(fields: [profileId], references: [id])
}

model CustomerProfile {
  id        String    @id @default(uuid())
  profileId String    @unique
  height    Int
  weight    Int
  goal      String?
  progressCustomerTrainings ProgressCustomerTraining[]
  profile   Profile   @relation(fields: [profileId], references: [id])
  totalPoints Int @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Session {
  id           String   @id @default(uuid())
  refreshToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent    String?
  ip           String?
  deviceInfo   Json?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}
/******************
 * Workout entities
 ******************
 */

model Exercise {
  id        String    @id @default(uuid())
  name      String
  difficulty Difficulty
  bodyPart BodyPart
  description String?
  imageUrl String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  workoutExercises WorkoutExercise[]
}

model WorkoutExercise {
  id        String    @id @default(uuid())
  reps      Int? //REPS
  duration  Int? //SECONDS
  distance  Int? //METERS
  weight    Float? //KG
  order     Int @default(0) 
  exerciseId String
  exercise  Exercise  @relation(fields: [exerciseId], references: [id])
  workoutBlockType WorkoutBlockType
  workoutType WorkoutType
  trainingDayId String
  trainingDay TrainingDay? @relation(fields: [trainingDayId], references: [id])
  progressCustomerWorkoutExercises ProgressCustomerWorkoutExercise[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt  
  deletedAt DateTime?
}

model TrainingDay {
  id        String    @id @default(uuid())
  workoutExercises WorkoutExercise[]
  order     Int @default(0) 
  trainingId String
  training Training? @relation(fields: [trainingId], references: [id])
  progressCustomerTrainingDays ProgressCustomerTrainingDay[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

enum TrainingStatus {
  DRAFT // Only visible to staff
  READY_TO_PUBLISH // only visible to staff and can be published to customers
  PUBLISHED // Visible to customers, they can launch it
  DISABLED // Visible to staff and customers, but customers cannot launch it
  HIDDEN // Visible to staff invisible to customers
}

model Training {
  id        String    @id @default(uuid())
  name      String
  description String?
  status TrainingStatus  @default(DRAFT)
  trainingDays TrainingDay[]
  progressCustomerTrainings ProgressCustomerTraining[]
  imageUrl String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

/******************
 * Customer & Training
 ******************
 */

enum CustomerProgressTrainingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
model ProgressCustomerTraining {
  id        String    @id @default(uuid())
  customerProfileId String
  customerProfile CustomerProfile? @relation(fields: [customerProfileId], references: [id])
  trainingId String
  training Training? @relation(fields: [trainingId], references: [id])
  status CustomerProgressTrainingStatus @default(NOT_STARTED)
  progressCustomerTrainingDays ProgressCustomerTrainingDay[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

enum ProgressCustomerTrainingDayStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}
model ProgressCustomerTrainingDay {
  id        String    @id @default(uuid())
  status ProgressCustomerTrainingDayStatus @default(NOT_STARTED)
  progressCustomerTrainingId String
  progressCustomerTraining ProgressCustomerTraining? @relation(fields: [progressCustomerTrainingId], references: [id])
  trainingDayId String
  trainingDay TrainingDay? @relation(fields: [trainingDayId], references: [id])
  progressCustomerWorkoutExercises ProgressCustomerWorkoutExercise[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

enum ProgressCustomerWorkoutExerciseStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}
model ProgressCustomerWorkoutExercise {
  id        String    @id @default(uuid())
  duration Int? //SECONDS
  status ProgressCustomerWorkoutExerciseStatus @default(NOT_STARTED)
  progressCustomerTrainingDayId String
  progressCustomerTrainingDay ProgressCustomerTrainingDay? @relation(fields: [progressCustomerTrainingDayId], references: [id])
  workoutExerciseId String
  workoutExercise WorkoutExercise? @relation(fields: [workoutExerciseId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  TRAINER
  CUSTOMER
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum BodyPart {
  CHEST
  SHOULDERS
  BACK
  ARMS
  LEGS
}

enum WorkoutType {
  STRENGTH
  HYPERTROPHY
  ENDURANCE
  POWER
  MOBILITY
  FLEXIBILITY
  BALANCE
  RECOVERY
}

enum WorkoutBlockType {
  WARM_UP
  MAIN_WORKOUT
  COOL_DOWN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}
/*********
 * User
 *********
 */
model User {
  id        String    @id @default(uuid())
  email     String    @unique
  createdAt DateTime  @default(now())
  role      Role      @default(CUSTOMER)
  updatedAt DateTime  @updatedAt
  passwordHash  String?
  profile   Profile?
  sessions  Session[]
}

model Profile {
  id              String           @id @default(uuid())
  userId          String           @unique
  bio             String?
  nickname        String 
  firstName       String?
  lastName        String?
  birthDate       DateTime
  gender          Gender
  imageUrl        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  customerProfile CustomerProfile?
  user            User             @relation(fields: [userId], references: [id])
  trainerProfile  TrainerProfile?

  @@index([nickname])
}

model TrainerProfile {
  id        String    @id @default(uuid())
  profileId String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  profile   Profile   @relation(fields: [profileId], references: [id])
}

model CustomerProfile {
  id        String    @id @default(uuid())
  profileId String    @unique
  height    Int
  weight    Int
  goal      String?
  trainingSessions TrainingSession[]
  profile   Profile   @relation(fields: [profileId], references: [id])
  totalPoints Int @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Session {
  id           String   @id @default(uuid())
  refreshToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent    String?
  ip           String?
  deviceInfo   Json?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}
/******************
 * Workout entities
 ******************
 */

model Exercise {
  id        String    @id @default(uuid())
  name      String
  difficulty Difficulty
  bodyPart BodyPart
  description String?
  imageUrl String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  workoutExercises WorkoutExercise[]
}

model WorkoutExercise {
  id        String    @id @default(uuid())
  reps      Int? //REPS
  duration  Int? //SECONDS
  distance  Int? //METERS
  weight    Float? //KG
  order     Int @default(0) 
  exerciseId String
  exercise  Exercise  @relation(fields: [exerciseId], references: [id])
  workoutBlockType WorkoutBlockType
  workoutType WorkoutType
  trainingDayId String
  trainingDay TrainingDay? @relation(fields: [trainingDayId], references: [id])
  workoutExerciseSessions WorkoutExerciseSession[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt  
}

model TrainingDay {
  id        String    @id @default(uuid())
  workoutExercises WorkoutExercise[]
  order     Int @default(0) 
  trainingId String
  training Training? @relation(fields: [trainingId], references: [id])
  trainingDaySessions TrainingDaySession[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

enum TrainingStatus {
  DRAFT // Only visible to staff
  READY_TO_PUBLISH // only visible to staff and can be published to customers
  PUBLISHED // Visible to customers, they can launch it
  DISABLED // Visible to staff and customers, but customers cannot launch it
  HIDDEN // Visible to staff invisible to customers
}

model Training {
  id        String    @id @default(uuid())
  name      String
  description String?
  status TrainingStatus  @default(DRAFT)
  trainingDays TrainingDay[]
  trainingSessions TrainingSession[]
  imageUrl String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

/******************
 * Customer & Training
 ******************
 */

enum TrainingSessionStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}
model TrainingSession {
  id        String    @id @default(uuid())
  customerProfileId String
  customerProfile CustomerProfile? @relation(fields: [customerProfileId], references: [id])
  trainingId String
  training Training? @relation(fields: [trainingId], references: [id])
  status TrainingSessionStatus @default(NOT_STARTED)
  trainingDaySessions TrainingDaySession[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

enum TrainingDaySessionStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}
model TrainingDaySession {
  id        String    @id @default(uuid())
  status TrainingDaySessionStatus @default(NOT_STARTED)
  trainingSessionId String
  trainingSession TrainingSession? @relation(fields: [trainingSessionId], references: [id])
  trainingDayId String
  trainingDay TrainingDay? @relation(fields: [trainingDayId], references: [id])
  workoutExerciseSessions WorkoutExerciseSession[]
  startedAt DateTime  @default(now())
  finishedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

enum WorkoutExerciseSessionStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}
model WorkoutExerciseSession {
  id        String    @id @default(uuid())
  timeSpent Int? // SECONDS
  status WorkoutExerciseSessionStatus @default(NOT_STARTED)
  trainingDaySessionId String
  trainingDaySession TrainingDaySession? @relation(fields: [trainingDaySessionId], references: [id])
  workoutExerciseId String
  workoutExercise WorkoutExercise? @relation(fields: [workoutExerciseId], references: [id])
  // Snapshot of targets at the time the day was started
  targetReps     Int?    // REPS
  targetDuration Int?    // SECONDS
  targetDistance Int?    // METERS
  targetWeight   Float?  // KG
  // Actual values performed by the customer
  actualReps     Int?    // REPS
  actualDuration Int?    // SECONDS
  actualDistance Int?    // METERS
  actualWeight   Float?  // KG
  // Tiemstamps
  startedAt DateTime?
  completedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

{
  "extends": ["@repo/typescript-config/expo.json", "expo/tsconfig.base"],
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.d.ts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    "assets.d.ts",
    "scripts/check-env.ts",
    "tailwind.config.js"
  ]
}

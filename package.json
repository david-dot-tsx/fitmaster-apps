{
  "name": "fitmaster-apps",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build:mobile": "turbo run build --filter=mobile",
    "build:web": "turbo run build --filter=web",
    "db:generate": "turbo run db:generate --filter=@repo/db",
    "db:deploy": "turbo run db:deploy --filter=@repo/db",
    "dev": "turbo run dev",
    "dev:mobile": "pnpm clean:mobile && turbo dev --filter=mobile -- --clearcache --android",
    "dev:web": "turbo dev --filter=web",
    "dev:backend": "turbo dev --filter=backend",
    "eas-build-post-install": "pnpm --filter @repo/db db:generate",
    "lint": "turbo run lint",
    "format": "prettier --cache --write .",
    "format:check": "prettier --cache --check .",
    "check-types": "turbo run check-types",
    "clean:mobile": "cd apps/mobile && rm -rf .expo && rm -rf node_modules/.cache/metro",
    "validate": "turbo run lint --continue && turbo run check-types --continue",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "20.3.1",
    "@commitlint/config-conventional": "20.3.1",
    "@commitlint/types": "20.3.1",
    "@tanstack/eslint-plugin-query": "5.91.2",
    "eslint-plugin-check-file": "3.3.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-tailwindcss": "3.18.2",
    "husky": "9.1.7",
    "prettier": "3.7.4",
    "prettier-plugin-tailwindcss": "0.7.2",
    "turbo": "2.7.4",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  }
}

{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "EXPO_OS",
    "DATABASE_URL",
    "COOKIE_REFRESH_TOKEN_MAX_AGE_IN_SECONDS",
    "COOKIE_TOKEN_MAX_AGE_IN_SECONDS",
    "NODE_ENV",
    "PORT",
    "HOST",
    "CORS_ORIGIN"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "^db:generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "DATABASE_URL",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_API_TRPC_PATH",
        "COOKIE_TOKEN_MAX_AGE_IN_SECONDS",
        "COOKIE_REFRESH_TOKEN_MAX_AGE_IN_SECONDS",
        "EXPO_PUBLIC_API_URL",
        "EXPO_PUBLIC_API_TRPC_PATH",
        "API_PROXY_TARGET_URL",
        "PLAYWRIGHT_DATABASE_URL"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "inputs": ["$TURBO_DEFAULT$", "eslint.config.{js,cjs,mjs}", ".eslintrc.{js,json}"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["transit"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "test:e2e-web": {
      "dependsOn": ["^test:e2e-web"]
    },
    "test:e2e-mobile": {
      "dependsOn": ["^test:e2e-mobile"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["DATABASE_URL", "PORT", "HOST", "CORS_ORIGIN", "NODE_ENV", "API_PROXY_TARGET_URL"]
    },
    "db:generate": {
      "cache": false,
      "inputs": ["prisma/schema.prisma"],
      "outputs": ["generated/**"]
    },
    "db:migrate": {
      "cache": false,
      "persistent": true
    },
    "db:deploy": {
      "cache": false,
      "inputs": ["prisma/schema.prisma", "prisma/migrations/**"],
      "env": ["DATABASE_URL"]
    }
  }
}

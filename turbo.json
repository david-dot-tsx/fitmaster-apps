{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalEnv": [
    "EXPO_OS",
    "DATABASE_URL",
    "COOKIE_REFRESH_TOKEN_MAX_AGE_IN_SECONDS",
    "COOKIE_TOKEN_MAX_AGE_IN_SECONDS",
    "NODE_ENV",
    "PORT",
    "HOST",
    "CORS_ORIGIN"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"],
      "env": [
        "DATABASE_URL",
        "NEXT_PUBLIC_API_URL",
        "NEXT_PUBLIC_API_TRPC_PATH",
        "COOKIE_TOKEN_MAX_AGE_IN_SECONDS",
        "COOKIE_REFRESH_TOKEN_MAX_AGE_IN_SECONDS"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "inputs": ["$TURBO_DEFAULT$", "eslint.config.{js,cjs,mjs}", ".eslintrc.{js,json}"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "env": ["DATABASE_URL", "PORT", "HOST", "CORS_ORIGIN", "NODE_ENV"]
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false,
      "persistent": true
    },
    "db:deploy": {
      "cache": false,
      "env": ["DATABASE_URL"]
    }
  }
}
